{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (Integrated Terminal)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}"
        },
        {
            "name": "Python: Current File (Integrated Terminal with Jack)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}"
        },
        {
            "name": "Pure Data: pyo~ under gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/pd",
            "args": [
                "-noprefs",
                "-stderr",
                "-path",
                "${workspaceFolder}/embedded/puredata"
            ],
            "cwd": "${workspaceFolder}/embedded/puredata",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false,
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing"
                }
            ]
        },
        {
            "name": "Python3d: Current File under gdb",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.venvd/bin/python3d",
            "args": [
                "${file}"
            ],
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false,
            "environment": [
                {
                    "name": "VIRTUAL_ENV",
                    "value": "${workspaceFolder}/.venvd"
                },
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/.venvd/bin:${env:PATH}"
                }
            ],
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing"
                }
            ]
        }
    ]
}
